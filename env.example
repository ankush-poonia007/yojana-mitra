# Yojana Mitra: environment variable names (Phase 3.3 contract)
#
# Copy this file to .env and fill in your own values. Never commit .env.
# Only non-secret defaults are filled in below; every key and model ID is blank on purpose.
#
# Backend: the app reads .env from the repository root.
# Frontend: Vite reads variables from its own folder, so copy the two VITE_ lines
#           into frontend/.env (or set envDir in vite.config.ts).
# Keys and the service-role key belong to the backend only, never to frontend code.

# ---------------------------------------------------------------- Backend: app
APP_ENV=development
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
# true = serve sample responses with no provider keys; set false for real processing.
# Never mix mock and real assessment results in one evaluation.
MOCK_MODE=true

# ------------------------------------------------------------- Backend: Gemini
GEMINI_API_KEY=
# Validate the exact model IDs and your quotas before filling these in.
GEMINI_MODEL_HIGH=
GEMINI_MODEL_MID=
GEMINI_MODEL_LITE=

# -------------------------------------------------------------- Backend: speech
# STT provider is chosen by the Hindi benchmark (candidates: Gemini transcription,
# Groq Whisper Large V3, Groq Whisper Large V3 Turbo).
STT_PROVIDER=
STT_API_KEY=
STT_MODEL=
# Approved direction: a Gemini lite-tier model; confirm the exact model and Hindi quality.
# The Gemini key can be reused here if the provider is Gemini.
TTS_PROVIDER=
TTS_API_KEY=
TTS_MODEL=

# ------------------------------------------------------------ Backend: Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Backend-only privileged key. Never expose it in frontend code, logs or commits.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --------------------------------------------------------------------- Frontend
# Server origin only; the API client adds /api/v1.
VITE_API_BASE_URL=http://localhost:8000
VITE_MOCK_MODE=true

# ------------------------------------------- Proposed addition (not yet agreed)
# Retrieval needs an embedding model, and the frozen list has no variable for it.
# Agree on it as a team before using it; the vector size in the chunks table must
# match the model's output size.
# GEMINI_EMBEDDING_MODEL=
